#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

official_command='gh workflow run release-unified.yml --repo openclaw/telecrawl -f version=X.Y.Z'

usage() {
  cat >&2 <<'EOF'
usage:
  scripts/release-local --check
  scripts/release-local pilot vX.Y.Z
  scripts/release-local draft
  scripts/release-local verify-draft vX.Y.Z
  scripts/release-local publish vX.Y.Z
  scripts/release-local homebrew vX.Y.Z
EOF
  exit 2
}

require_tools() {
  local tool
  for tool in "$@"; do
    command -v "$tool" >/dev/null 2>&1 || {
      echo "release: missing required command: $tool" >&2
      exit 1
    }
  done
}

refuse_local_release() {
  echo "local releases are disabled because only the shared workflow can enforce the signed, notarized, reproducible-rebuild, verifier, publication, and Homebrew chain" >&2
  echo "official releases must use: $official_command" >&2
  exit 1
}

mode=${1:-}
shift || true
case "$mode" in
  --check)
    [[ "$#" -eq 0 ]] || usage
    require_tools goreleaser
    goreleaser check
    if command -v actionlint >/dev/null 2>&1; then
      actionlint .github/workflows/release-unified.yml
    else
      require_tools go
      GOWORK=off go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 \
        .github/workflows/release-unified.yml
    fi
    grep -Fq 'uses: openclaw/release-workflows/.github/workflows/release-go-cli.yml@v1' \
      .github/workflows/release-unified.yml
    grep -Fq 'reproducible-rebuild: non-darwin' .github/workflows/release-unified.yml
    [[ ! -e .github/workflows/release-assets.yml ]]
    [[ ! -e scripts/rebuild-release-assets.sh ]]
    scripts/test-codesign-macos.sh
    scripts/test-release-local.sh
    echo "release: unified workflow contract passed"
    ;;
  draft)
    [[ "$#" -eq 0 ]] || usage
    refuse_local_release
    ;;
  pilot|verify-draft|publish|homebrew)
    [[ "$#" -eq 1 && "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || usage
    refuse_local_release
    ;;
  *) usage ;;
esac
